{
  "name": "@chialab/rna-project",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Build tools for Web Components.",
  "author": "Chialab <dev@chialab.io> (https://www.chialab.it)",
  "license": "MIT",
  "scripts": {
    "clear": "rimraf --glob 'packages/*/{types,*.tsbuildinfo}' 'packages/*/dist'",
    "build": "pnpm -r run build",
    "types": "rimraf --glob 'packages/*/{types,*.tsbuildinfo}' && tsc -b",
    "lint": "biome check",
    "test": "vitest --coverage",
    "new": "plop --plopfile internals/generators/plopfile.js module",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "version": "changeset version && pnpm install --no-frozen-lockfile"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chialab/rna"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@chialab/rna": "*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chai-string": "^1.6.0",
    "jsonc-parser": "^3.3.1",
    "plop": "^4.0.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.2.1+sha512.f55ca68aacb9eb5ab69c66f828a98af89a32286703aef1f8da131ca7eab4d677f34bfa85e186467a919c0799df8b6f4aa240f7dc2919b33b3273190104162616"
}
